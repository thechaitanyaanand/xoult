# Local default matches docker-compose.yml.
# For Supabase use the "Session pooler" URI (Project Settings > Database > Connect);
# the direct connection is IPv6-only on the free plan.
DATABASE_URL=postgresql://xoult:xoult@localhost:5432/xoult

# LLM providers, read by LiteLLM. Free keys: console.groq.com, aistudio.google.com
GROQ_API_KEY=
GEMINI_API_KEY=
# JSON list, primary first. Fully local alternative: ["ollama/qwen2.5:1.5b"]
# LLM_MODELS=["groq/openai/gpt-oss-20b", "gemini/gemini-3.5-flash-lite"]

# Optional: LLM tracing (cloud.langfuse.com) and API error tracking (sentry.io)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=
