# Local default matches docker-compose.yml.
# For Supabase use the "Session pooler" URI (Project Settings > Database > Connect);
# the direct connection is IPv6-only on the free plan.
DATABASE_URL=postgresql://xoult:xoult@localhost:5433/xoult

# LLM providers, read by LiteLLM. Any subset works: missing or failing providers are
# skipped (see llm.py). Free: console.groq.com, aistudio.google.com, openrouter.ai (":free"
# models only without credit), llama.developer.meta.com. xAI (console.x.ai) needs credits.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LLAMA_API_KEY=
XAI_API_KEY=
# JSON list, tried in order. Fully local alternative: ["ollama/qwen2.5:1.5b"] with LLM_RPM=600
# LLM_MODELS=["groq/openai/gpt-oss-20b", "gemini/gemini-3.5-flash-lite"]

# Sessions. Generate once with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Production must set SECRET_KEY and COOKIE_SECURE=true (the app refuses to start otherwise).
SECRET_KEY=
COOKIE_SECURE=false
# Optional "Sign in with Google": an OAuth 2.0 Web client id (see DEPLOY.md, Part 2)
GOOGLE_CLIENT_ID=

# Optional: LLM tracing (cloud.langfuse.com) and API error tracking (sentry.io)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=

# Optional: lets the API start the ingest workflow to embed a paper a reader adds by
# hand, so it shapes their feed within minutes instead of at the next scheduled run.
# Fine-grained token, this repository only, permission "Actions: read and write".
GITHUB_TOKEN=
# GITHUB_REPO=thechaitanyaanand/xoult
